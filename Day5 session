****HSRP - hotstandby routing protocol

@coretaas as PLDT -primary ISP
conf t
hostname coretaasPLDT
track 1 int g0/1 line-protocol
 int vlan 1
 standby 1 ip 10.31.1.6
 standby 1 preempt
 standby 1 priority 150
 standby 1 track 1 decrement 60
end

@corebaba as Globe -secondary ISP

conf t
hostname corebabaGlobe
int vlan 1 
standby 1 ip 10.31.1.6
 standby 1 preempt
 standby 1 priority 100
end

